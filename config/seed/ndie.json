  "questions": [
    {
      "id": "mobility-difficulty",
      "text": "Do you find it difficult getting around?",
      "type": "yes_no"
    },
    {
      "id": "mobility-details",
      "text": "What makes getting around difficult?",
      "type": "text"
    },
    {
      "id": "health-illnesses",
      "text": "Do you have any illnesses?",
      "type": "yes_no"
    },
    {
      "id": "health-illness-type",
      "text": "What type of illness?",
      "type": "text"
    },
    {
      "id": "health-seen-doctor",
      "text": "Have you seen a doctor about it?",
      "type": "yes_no"
    },
    {
      "id": "finance-need-help",
      "text": "Do you need financial help?",
      "type": "yes_no"
    },
    {
      "id": "finance-areas",
      "text": "What do you need help with?",
      "type": "multiple_choice",
      "options": [
        "Benefits",
        "Bills",
        "Debt",
        "Housing costs",
        "Other"
      ]
    },
    {
      "id": "social-lonely",
      "text": "Do you often feel lonely?",
      "type": "yes_no"
    },
    {
      "id": "social-contact-frequency",
      "text": "How often do you speak to family or friends?",
      "type": "single_choice",
      "options": [
        "Every day",
        "Every week",
        "Every month",
        "Less often"
      ]
    },
    {
      "id": "outcome-helped",
      "text": "Do you feel this service has helped you?",
      "type": "yes_no"
    },
    {
      "id": "outcome-further-help",
      "text": "Do you need further help?",
      "type": "yes_no"
    },
    {
      "id": "outcome-improved",
      "text": "How much has your situation improved?",
      "type": "scale",
      "scale": {
        "min": 1,
        "max": 5,
        "minLabel": "Not at all",
        "maxLabel": "A lot"
      }
    },
    {
      "id": "outcome-comments",
      "text": "Anything else you'd like to tell us?",
      "type": "text"
    }
  ],
  "questionSets": [
    {
      "id": "mobility",
