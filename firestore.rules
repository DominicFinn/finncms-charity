rules_version = '2';

// All application data is read and written through Cloud Functions, which
// check permissions and write the audit log server side. Browsers and MCP
// clients never touch Firestore directly, so every path is closed here.
// This is what makes "every read is audited" enforceable: a read that skips
// the functions layer is not possible.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
