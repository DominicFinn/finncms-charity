# Copy to functions/.env.<project-id> and fill in. Secrets go in Secret Manager
# (see README), not here.

# Email of the first super user. The first time this person signs in they are
# given the super user role, provided no super user exists yet.
BOOTSTRAP_SUPERUSER_EMAIL=you@example.org

# Public URL of the web app, used for links in calendar events and OAuth return.
APP_URL=https://your-project.web.app

# Google OAuth client for calendar sync (optional). The secret is set with
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_OAUTH_CLIENT_ID=
