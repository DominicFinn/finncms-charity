{
  "name": "charity-contact-management",
  "private": true,
  "description": "Open source client and case management for small charities",
  "workspaces": [
    "packages/shared",
    "functions",
    "web",
    "scripts"
  ],
  "scripts": {
    "build": "npm run build -w functions && npm run build -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "emulators": "firebase emulators:start --import=.emulator-data --export-on-exit",
    "dev": "npm run dev -w web",
    "seed": "npm run seed -w scripts --"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
