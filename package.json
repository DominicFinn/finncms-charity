{
  "name": "charity-contact-management",
  "private": true,
  "description": "Open source client and case management for small charities",
  "workspaces": [
    "packages/shared",
    "functions",
    "web",
    "scripts"
  ],
  "scripts": {
    "build": "npm run build -w functions && npm run build -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "emulators": "firebase emulators:start --import=.emulator-data --export-on-exit",
    "dev": "npm run dev -w web",
    "seed": "npm run seed -w scripts --",
    "setup": "npm run setup -w scripts --",
    "deploy": "npm run deploy -w scripts --",
    "doctor": "npm run doctor -w scripts --",
    "site:init": "npm run site:init -w scripts --",
    "site:check": "npm run test -w web -- src/theme/site-check.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "firebase-tools": "^15.35.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
