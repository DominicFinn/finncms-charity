# Firebase web app config (Project settings > General > Your apps).
# Optional: when these are empty, the app reads its config from Firebase
# Hosting at /__/firebase/init.json, which is the simplest way to deploy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Built in theme to use when there's no site/theme.ts: "default" or "green".
# A site/theme.ts always wins, so most charities never set this.
VITE_THEME=default

# Set to true to use the local Firebase emulators. Only in
# web/.env.development.local: a production build refuses to run with it.
VITE_USE_EMULATORS=false
